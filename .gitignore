# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtualenv ──────────────────────────────────────────
.venv/
venv/

# ── Build artifacts (PyInstaller / AppImage / .deb) ─────
packaging/build/
packaging/dist/
packaging/deb/
packaging/cyext/
# never build the engine in-place: a stale extension would silently shadow edited sources
evolution/*.so
evolution/*.pyd
# per-build provenance stamp, generated by make_build_stamp.py at build time
alphanode/_build_stamp.json
packaging/AlphaNode.AppDir/
packaging/appimagetool-x86_64.AppImage

# ── Runtime state & outputs (regenerated by the app/node)
alphanode/state/
exports/
evolution/experiments/
paper_state.json
paper_trades.csv
# the leaderboard "CSV" export, saved wherever the user pointed the dialog
library_*.csv
leaderboard_top*.csv
# signal/portfolio CSVs and PDF reports saved from the GUI dialogs
signals_*.csv
forward_*.csv
report_*.pdf

# ── Logs ────────────────────────────────────────────────
*.log

# ── Generated plots ─────────────────────────────────────
eval_*.png
evolution/evo_*.png

# ── OS junk ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── market data snapshot (binary, 4.6MB, refreshed by the fetcher — not for git) ──
data*.pickle

# ── local research scratch (notebooks etc.) — not for git ──

research/
alphanode/anthropic_key
alphanode/alphahub_identity
alphanode/vault_server_key
alphanode/vault_server_key.pub
alphahub/vault_key
alphahub/vault_key.pub
alphahub/hub.db
deploy/.env
deploy/hubdata/
token_tokenovich

# ── local build venv / installer output ──
.venv-build/
.venv*/
venv*/
packaging/Output/
packaging/incoming/
.python-tk86/
